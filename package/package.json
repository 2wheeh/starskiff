{
  "name": "starskiff",
  "version": "0.8.1",
  "description": "Lightweight Cosmos SDK test instances via child processes",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "check": "tsc -b",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:package": "pnpm build && publint --strict --level warning && attw --pack . --profile esm-only --no-definitely-typed"
  },
  "keywords": [
    "cosmos",
    "testing",
    "simd",
    "cosmjs"
  ],
  "author": "wnhlee <https://github.com/2wheeh>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2wheeh/starskiff",
    "directory": "package"
  },
  "homepage": "https://github.com/2wheeh/starskiff#readme",
  "bugs": {
    "url": "https://github.com/2wheeh/starskiff/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "mitt": "^3.0.1",
    "tinyexec": "^1.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cosmjs/cosmwasm-stargate": "^0.38.1",
    "@cosmjs/crypto": "^0.38.1",
    "@cosmjs/proto-signing": "^0.38.1",
    "@cosmjs/stargate": "^0.38.1",
    "@types/node": "^25.9.9",
    "cosmjs-types": "^0.11.0",
    "publint": "0.3.25",
    "typescript": "^6.0.3",
    "viem": "^2.57.16",
    "vitest": "^4.1.12"
  }
}
